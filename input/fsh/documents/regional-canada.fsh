// ---------------------------------------------------------------- Invariants

Invariant: hc-cpid-sec-1
Description: "A sub-section's CPID code sits under its parent's CPID code (keeps the template hierarchy)."
Severity: #error
Expression: "section.all(code.coding.where(system = 'http://hl7.org/fhir/uv/pharm-quality/CodeSystem/hc-cpid-section-pq').code.first().startsWith(%context.code.coding.where(system = 'http://hl7.org/fhir/uv/pharm-quality/CodeSystem/hc-cpid-section-pq').code.first() & '.'))"

Invariant: hc-cpid-ce-1
Description: "A CPID-CE has one Summary of Product Information section, and its other top-level sections are Drug Substance or Drug Product (Drug Product may be omitted when the CPID-CE is part of a Type I Master File)."
Severity: #error
Expression: "section.where(code.coding.where(system = 'http://hl7.org/fhir/uv/pharm-quality/CodeSystem/hc-cpid-section-pq' and code = 'CE-SUMMARY').exists()).count() = 1 and section.all(code.coding.where(system = 'http://hl7.org/fhir/uv/pharm-quality/CodeSystem/hc-cpid-section-pq' and (code = 'CE-SUMMARY' or code = 'CE-2.3.S' or code = 'CE-2.3.P')).exists())"

Invariant: hc-cpid-b-1
Description: "A CPID-B has one Introduction section, and its other top-level sections are Drug Substance, Drug Product, Appendices or Regional Information."
Severity: #error
Expression: "section.where(code.coding.where(system = 'http://hl7.org/fhir/uv/pharm-quality/CodeSystem/hc-cpid-section-pq' and code = 'B-INTRO').exists()).count() = 1 and section.all(code.coding.where(system = 'http://hl7.org/fhir/uv/pharm-quality/CodeSystem/hc-cpid-section-pq' and (code = 'B-INTRO' or code = 'B-S' or code = 'B-P' or code = 'B-A' or code = 'B-R')).exists())"

// ---------------------------------------------------------------- Profiles

Profile: CompositionCpidPq
Parent: Composition
Id: Composition-cpid-pq
Title: "Composition - Health Canada CPID (base)"
Description: "Abstract base for the Composition of a Health Canada Certified Product Information Document (CPID-CE or CPID-B) at PQI Type 1: the Health Canada Word template converted 1:1 into coded sections with narrative. Images are separate Bundle entries (Binary + DocumentReference); no other resources are referenced."
* ^status = #active
* ^abstract = true
* ^jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* obeys pqi-sec-2 and pqi-txt-1 and pqi-t1-1 and pqi-t1-2
* status MS
* type 1..1 MS
* type from VsHcCpidDocumentTypePq (required)
* category 1..1 MS
* category = PqiMaturityType#type-1
* category ^short = "PQI maturity type (type-1 only for CPIDs in this version)"
* subject MS
* subject.reference 0..0
* subject ^short = "Display text only (e.g. drug substance or product name)"
* date MS
* author MS
* author.reference 0..0
* author ^short = "Display text only (e.g. company name)"
* title MS
* relatesTo MS
* relatesTo ^short = "Previous CPID version this one replaces"
* contained 0..0
* section 1..* MS
* section obeys pqi-sec-2 and hc-cpid-sec-1
* section.title 1..1 MS
* section.title ^short = "Heading as in the template, including its parenthetical identifier (e.g. name, manufacturer)"
* section.code 1..1 MS
* section.text MS
* section.entry MS
* section.entry only Reference(DocumentReferenceDrugPq)
* section.entry ^short = "Image DocumentReferences only"

Profile: CompositionCpidCePq
Parent: CompositionCpidPq
Id: Composition-cpid-ce-pq
Title: "Composition - Health Canada CPID-CE"
Description: "Certified Product Information Document - Chemical Entities (CPID-CE) at PQI Type 1. Sections follow the Health Canada CPID-CE template: a Summary of Product Information, then a Drug Substance section per drug substance (and manufacturer) and a Drug Product section per dosage form."
* ^status = #active
* ^abstract = false
* obeys hc-cpid-ce-1
* type = HcCpidDocumentTypePq#cpid-ce
* section.code from VsHcCpidCeSectionPq (required)

Profile: CompositionCpidBPq
Parent: CompositionCpidPq
Id: Composition-cpid-b-pq
Title: "Composition - Health Canada CPID-B"
Description: "Certified Product Information Document - Biologics (Schedule D drugs) (CPID-B) at PQI Type 1. Sections follow the Health Canada CPID-B template: an Introduction, then Drug Substance, Drug Product, Appendices and Regional Information."
* ^status = #active
* ^abstract = false
* obeys hc-cpid-b-1
* type = HcCpidDocumentTypePq#cpid-b
* section.code from VsHcCpidBSectionPq (required)

Profile: BundleCpidCePq
Parent: BundleDocumentPq
Id: Bundle-cpid-ce-pq
Title: "Bundle - Health Canada CPID-CE Document"
Description: "CPID-CE document at PQI Type 1: the Composition plus one Binary and one DocumentReference per image, and nothing else."
* ^status = #active
* ^abstract = false
* ^jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* insert PqiEntrySlicing(#closed)
* entry contains composition 1..1 MS
* entry[composition].resource only CompositionCpidCePq
* insert PqiImageSlices

Profile: BundleCpidBPq
Parent: BundleDocumentPq
Id: Bundle-cpid-b-pq
Title: "Bundle - Health Canada CPID-B Document"
Description: "CPID-B document at PQI Type 1: the Composition plus one Binary and one DocumentReference per image, and nothing else."
* ^status = #active
* ^abstract = false
* ^jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* insert PqiEntrySlicing(#closed)
* entry contains composition 1..1 MS
* entry[composition].resource only CompositionCpidBPq
* insert PqiImageSlices

