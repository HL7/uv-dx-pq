// Health Canada regional documents: Certified Product Information Documents (CPID-CE and CPID-B).
// Generated by Claude outputs/gen_cpid.py (separate from the PQI maturity-type generator). To change the headings, edit Claude outputs/gen_cpid.py and rerun it: python3 gen_cpid.py input/fsh/documents/terminology.fsh input/fsh/documents/regional-canada.fsh <tables.html>
// Sources: Health Canada CPID-CE guidance (effective 2018-01-30) and CPID-B (Schedule D drugs) template (2024-06-04).

// ---------------------------------------------------------------- Terminology

CodeSystem: HcCpidSectionPq
Id: hc-cpid-section-pq
Title: "Health Canada CPID Section Headings PQ"
Description: """Headings of the Health Canada Certified Product Information Documents: CPID-CE (chemical entities) and CPID-B (biologics, Schedule D drugs).
CPID-CE codes keep the Quality Overall Summary numbering of the Health Canada template (e.g. CE-2.3.S.1.2); CPID-B codes use the Module 3.2 numbering each CPID-B heading summarizes (e.g. B-S.2.1).
The ConceptMap hc-cpid-to-ctd-pq maps each heading to the ICH M4Q(R1) Module 3.2 heading it is condensed from."""
* ^status = #active
* ^experimental = false
* ^caseSensitive = true
* ^hierarchyMeaning = #part-of
* ^content = #complete
* ^jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* #CPID-CE "CPID-CE headings" "Root grouping the headings of the Certified Product Information Document - Chemical Entities. Not used as a section code."
  * #CE-SUMMARY "Summary of Product Information"
  * #CE-2.3.S "Drug Substance"
    * #CE-2.3.S.1 "General Information"
      * #CE-2.3.S.1.2 "Structure"
      * #CE-2.3.S.1.3 "General Properties"
    * #CE-2.3.S.2 "Manufacture"
      * #CE-2.3.S.2.1 "Manufacturer(s)"
      * #CE-2.3.S.2.2 "Description of Manufacturing Process and Process Controls"
    * #CE-2.3.S.3.2 "Impurities"
    * #CE-2.3.S.4 "Control of the Drug Substance"
      * #CE-2.3.S.4.1 "Specification"
    * #CE-2.3.S.6 "Container Closure System"
    * #CE-2.3.S.7 "Stability"
      * #CE-2.3.S.7.1 "Stability Summary and Conclusions"
  * #CE-2.3.P "Drug Product"
    * #CE-2.3.P.1 "Description and Composition of the Drug Product"
    * #CE-2.3.P.3 "Manufacture"
      * #CE-2.3.P.3.1 "Manufacturer(s)"
      * #CE-2.3.P.3.2 "Batch Formula"
      * #CE-2.3.P.3.3 "Description of Manufacturing Process and Process Controls"
      * #CE-2.3.P.3.4 "Controls of Critical Steps and Intermediates"
      * #CE-2.3.P.3.5 "Process Validation and/or Evaluation"
    * #CE-2.3.P.5 "Control of Drug Product"
      * #CE-2.3.P.5.1 "Specification(s)"
    * #CE-2.3.P.7 "Container Closure System"
    * #CE-2.3.P.8 "Stability"
      * #CE-2.3.P.8.1 "Stability Summary and Conclusions"
      * #CE-2.3.P.8.2 "Post-approval Stability Protocol and Stability Commitment"
      * #CE-2.3.P.8.3 "Stability Data"
* #CPID-B "CPID-B headings" "Root grouping the headings of the Certified Product Information Document - Biologics (Schedule D drugs). Not used as a section code."
  * #B-INTRO "Introduction"
  * #B-S "Drug Substance"
    * #B-S.2 "Manufacture"
      * #B-S.2.1 "Manufacturer(s)"
      * #B-S.2.2 "Description of Manufacturing Process and Process Controls"
      * #B-S.2.3 "Control of Materials"
      * #B-S.2.4 "Controls of Critical Steps and Intermediates"
    * #B-S.3 "Characterisation"
      * #B-S.3.1 "Elucidation of Structure and other Characteristics"
      * #B-S.3.2 "Impurities"
    * #B-S.4 "Control of Drug Substance"
      * #B-S.4.1 "Specifications"
    * #B-S.5 "Reference Standards or Materials"
    * #B-S.6 "Container Closure System"
    * #B-S.7 "Stability"
      * #B-S.7.1 "Stability Summary and Conclusions"
      * #B-S.7.2 "Post-approval Stability Protocol and Stability Commitment"
  * #B-P "Drug Product"
    * #B-P.3 "Manufacture"
      * #B-P.3.1 "Manufacturer(s)"
      * #B-P.3.2 "Batch Formula"
      * #B-P.3.3 "Description of Manufacturing Process and Process Controls"
      * #B-P.3.4 "Controls of Critical Steps and Intermediates"
    * #B-P.4 "Control of Excipients"
      * #B-P.4.5 "Excipients of Human or Animal Origin"
    * #B-P.5 "Control of Drug Product"
      * #B-P.5.1 "Specifications"
    * #B-P.6 "Reference Standards or Materials"
    * #B-P.7 "Container Closure System"
    * #B-P.8 "Stability"
      * #B-P.8.1 "Stability Summary and Conclusion"
      * #B-P.8.2 "Post-approval Stability Protocol and Stability Commitment"
  * #B-A "Appendices"
    * #B-A.1 "Facilities and Equipment"
    * #B-A.2 "Adventitious Agents Safety Evaluation"
  * #B-R "Regional Information"
    * #B-R.2 "Medical Devices"
    * #B-R.8 "Product Lifecycle Management Information"

ValueSet: VsHcCpidCeSectionPq
Id: vs-hc-cpid-ce-section-pq
Title: "Health Canada CPID-CE Section Headings PQ"
Description: "All headings of the CPID-CE, used to code Composition.section in a CPID-CE document."
* ^status = #active
* ^experimental = false
* ^jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* include codes from system HcCpidSectionPq where concept descendent-of #CPID-CE

ValueSet: VsHcCpidBSectionPq
Id: vs-hc-cpid-b-section-pq
Title: "Health Canada CPID-B Section Headings PQ"
Description: "All headings of the CPID-B (Schedule D drugs), used to code Composition.section in a CPID-B document."
* ^status = #active
* ^experimental = false
* ^jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* include codes from system HcCpidSectionPq where concept descendent-of #CPID-B

CodeSystem: HcCpidDocumentTypePq
Id: hc-cpid-document-type-pq
Title: "Health Canada CPID Document Type PQ"
Description: "The Health Canada Certified Product Information Document template a CPID document follows."
* ^status = #active
* ^experimental = false
* ^caseSensitive = true
* ^content = #complete
* ^jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* #cpid-ce "Certified Product Information Document - Chemical Entities" "CPID-CE for New Drug Submissions and Abbreviated New Drug Submissions of synthetic or semi-synthetic drugs (Part C, Division 8 of the Food and Drug Regulations)."
* #cpid-b "Certified Product Information Document - Biologics (Schedule D drugs)" "CPID-B for biologic (Schedule D) drugs."

ValueSet: VsHcCpidDocumentTypePq
Id: vs-hc-cpid-document-type-pq
Title: "Health Canada CPID Document Type PQ"
Description: "All Health Canada CPID document types."
* ^status = #active
* ^experimental = false
* ^jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* include codes from system HcCpidDocumentTypePq

Instance: hc-cpid-to-ctd-pq
InstanceOf: ConceptMap
Usage: #definition
Title: "Health Canada CPID headings to ICH M4Q(R1) Module 3.2 headings"
Description: "Maps each CPID-CE and CPID-B heading to the Module 3.2 heading whose content it condenses, so that a CPID section can be traced to, checked against or generated from its Module 3.2 source. CPID-B regional headings (Medical Devices, Product Lifecycle Management) map to 3.2.R, because 3.2.R sub-headings are defined by each regulator and not coded in ctd-section-pq."
* url = "http://hl7.org/fhir/uv/pharm-quality/ConceptMap/hc-cpid-to-ctd-pq"
* name = "HcCpidToCtdPq"
* title = "Health Canada CPID headings to ICH M4Q(R1) Module 3.2 headings"
* status = #active
* experimental = false
* jurisdiction = urn:iso:std:iso:3166#CA "Canada"
* sourceScopeCanonical = "http://hl7.org/fhir/uv/pharm-quality/ValueSet/vs-hc-cpid-ce-section-pq"
